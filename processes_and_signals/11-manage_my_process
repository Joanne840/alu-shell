#!/usr/bin/env bash
# Manages the background process with start, stop, and restart commands
PIDFILE="/var/run/my_process.pid"
DAEMON="./manage_my_process"

case "$1" in
    start)
        if [ -f "$PIDFILE" ]; then
            echo "manage_my_process already started"
            exit 1
        fi
        $DAEMON &
        echo $! > "$PIDFILE"
        echo "manage_my_process started"
        ;;
    stop)
        if [ ! -f "$PIDFILE" ]; then
            echo "cat: /var/run/my_process.pid: No such file or directory"
            exit 1
        fi
        PID=$(cat "$PIDFILE")
        kill "$PID" 2>/dev/null
        rm -f "$PIDFILE"
        echo "manage_my_process stopped"
        ;;
    restart)
        if [ -f "$PIDFILE" ]; then
            PID=$(cat "$PIDFILE")
            kill "$PID" 2>/dev/null
            rm -f "$PIDFILE"
        fi
        $DAEMON &
        echo $! > "$PIDFILE"
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        exit 1
        ;;
esac
